#!/bin/bash

function usage() {
    echo "usage: $0 {gcc|gcc-lto|gcc-pgo|gcc-instrument|clang|clang-lto|clang-pgo|clang-instrument} [clingo-args...]" >&2
    exit 1
}

[[ $# -gt 0 ]] || usage

loc="$(realpath "$(dirname "$0")")"

case $1 in
gcc-opt)
    dir=release
    ;;
gcc-lto)
    dir=release_lto
    ;;
gcc-pgo)
    dir=release_pgo
    ;;
gcc-instrument)
    dir=release_instrument
    ;;
clang-opt)
    dir=release
    ;;
clang-lto)
    dir=release_clang_lto
    ;;
clang-pgo)
    dir=release_clang_pgo
    ;;
clang-instrument)
    dir=release_clang_instrument
    ;;
*)
    usage
    ;;
esac
shift

exec "$loc/../../build/$dir/bin/clingo" "$@"
