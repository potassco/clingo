<runscript output="output">

	<machine name="precision-3480" cpu="i7-1370P" memory="32GB"/>

	<config name="default" template="templates/seq-generic.sh"/>

	<system name="clingo" version="6.0.0" measures="clasp" config="default" cmdline="">
		<setting name="gcc-opt"          cmdline="gcc-opt          --opt-str=usc --stats -q --project-anonymous" tag="benchmark"/>
		<setting name="gcc-lto"          cmdline="gcc-lto          --opt-str=usc --stats -q --project-anonymous" tag="benchmark"/>
		<setting name="gcc-pgo"          cmdline="gcc-pgo          --opt-str=usc --stats -q --project-anonymous" tag="benchmark"/>
		<setting name="gcc-instrument"   cmdline="gcc-instrument   --opt-str=usc --stats -q --project-anonymous" tag="instrument"/>
		<setting name="clang-opt"        cmdline="clang-opt        --opt-str=usc --stats -q --project-anonymous" tag="benchmark"/>
		<setting name="clang-lto"        cmdline="clang-lto        --opt-str=usc --stats -q --project-anonymous" tag="benchmark"/>
		<setting name="clang-pgo"        cmdline="clang-pgo        --opt-str=usc --stats -q --project-anonymous" tag="benchmark"/>
		<setting name="clang-instrument" cmdline="clang-instrument --opt-str=usc --stats -q --project-anonymous" tag="instrument"/>
	</system>

	<seqjob name="default" timeout="300s" runs="1" parallel="1"/>

	<benchmark name="clingo">
		<folder path="benchmarks/"></folder>
	</benchmark>

	<project name="clingo-instrument" job="default">
		<runtag machine="precision-3480" benchmark="clingo" tag="instrument"/>
	</project>

	<project name="clingo-benchmark" job="default">
		<runtag machine="precision-3480" benchmark="clingo" tag="benchmark"/>
	</project>

</runscript>
