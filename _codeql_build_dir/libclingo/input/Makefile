	cd /home/runner/work/clingo/clingo/_codeql_build_dir && $(MAKE) $(MAKESILENT) -f libclingo/input/CMakeFiles/test_clingo-input.dir/build.make libclingo/input/CMakeFiles/test_clingo-input.dir/tests/variables.cc.i
.PHONY : tests/variables.cc.i

tests/variables.s: tests/variables.cc.s
.PHONY : tests/variables.s

# target to generate assembly for a file
tests/variables.cc.s:
	cd /home/runner/work/clingo/clingo/_codeql_build_dir && $(MAKE) $(MAKESILENT) -f libclingo/input/CMakeFiles/test_clingo-input.dir/build.make libclingo/input/CMakeFiles/test_clingo-input.dir/tests/variables.cc.s
.PHONY : tests/variables.cc.s

