#const n=6.
{ q(1..n,1..n) }.
:- { q(1..n,Y) } != 1, Y=1..n.
:- { q(X,1..n) } != 1, X=1..n.
:- { q(D-Y,Y) } >= 2, D=2..2*n.
:- { q(D+Y,Y) } >= 2, D=1-n..n-1.

