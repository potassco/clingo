atom(A) :- hasatom(A,_,_).
atom(A) :- hasatom(e(_,A),_,_).
nonvatom(X) :- atom(X), X!=v(V): atom(v(V)).

triviallyfalse(n(X),n(Y)) :- atom(n(X)), atom(n(Y)), X!=Y.
triviallyfalse(e(R1,C1),e(R2,C2)) :- atom(e(R1,C1)), atom(e(R2,C2)), R1!=R2.
triviallyfalse(n(C),e(R,C1)) :- atom(n(C)), atom(e(R,C1)).
triviallyfalse(e(R,C1),n(C)) :- atom(n(C)), atom(e(R,C1)).

subs(X,Y) :- subs(e(R,X),e(R,Y)).

1 { subs(Y,X): hasatom(Y,|P-1|,E), not triviallyfalse(Y,X) } :- hasatom(X,P,E), nonvatom(X).

1 { subs(Y,C): hasatom(Y,|P-1|,E), not triviallyfalse(Y,C) } :- subs(X,C), hasatom(X,P,E),
                  nonvatom(C), not hasatom(C,PX,E):hasatom(C,PX,E).

subs(X,Z) :- subs(X,Y), subs(Y,Z), X!=Z, X!=Y, Z!=Y.

:- subs(X,Y), triviallyfalse(X,Y).

greater(X,Y) :- subs(v(X),e(R,v(Y))).
:- greater(X,X).
greater(X,Z) :- greater(X,Y), greater(Y,Z), X!=Y, X!=Z, Y!=Z.

atom(C) :- diseq(C,D).
atom(D) :- diseq(C,D).

1 { dissubs(X,Y); dissubs(Y,X) } :- diseq(X,Y).
ok(C,D) :- dissubs(C,D), subs(D,D'), nonvatom(D'), not subs(C,D'), not subs(C',D'): subs(C,C').
:- dissubs(C,D), not ok(C,D).

r(v(X),C) :- subs(v(X),C), relevant(X), nonvatom(C).

