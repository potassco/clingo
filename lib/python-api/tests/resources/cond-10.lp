% conditional literals with recursive premises
d(1..3).
{ q(X) } :- d(X).
p(X) :- d(X), p(Y) : q(Y), Y < X.
a :- b : a.
b :- a : b.
#show a/0.
#show b/0.
#show p/1.
#show q/1.

