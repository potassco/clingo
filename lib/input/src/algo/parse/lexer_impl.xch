/*!re2c
    re2c:api:style             = free-form;
    re2c:define:YYCTYPE        = char;
    re2c:define:YYCURSOR       = state_.cursor();
    re2c:define:YYMARKER       = state_.marker();
    re2c:define:YYCTXMARKER    = state_.ctxmarker();
    re2c:define:YYLIMIT        = state_.limit();
    re2c:define:YYFILL         = state_.fill();
    re2c:define:YYGETCONDITION = condition;
    re2c:define:YYSETCONDITION = "condition = @@;";
    re2c:eof                   = 0;
    re2c:cond:goto             = "continue;";

    DEC        = "0"|([1-9][0-9]*);
    HEX        = "0x"([0-9A-Fa-f]+);
    OCT        = "0o"([1-7]+);
    BIN        = "0b"([0-1]+);
    NUMBER     = DEC | HEX | OCT | BIN;
    SKIP       = [\t\r ]*;
    NL         = "\n";
    IDENTIFIER = [_']*[a-z]['A-Za-z0-9_]*;
    VARIABLE   = [_']*[A-Z]['A-Za-z0-9_]*;
    STRING     = "\"" ([^\\"\n]|"\\\""|"\\\\"|"\\n")* "\"";
    THEORYOP   = [/!<=>+\-*\\?&@|:;~\^\.]+;
    KEYWORD    = "#" [a-zA-Z0-9_]*;
*/

/*!conditions:re2c*/

auto Parser::Impl::lex_(Condition cond) -> TokenType {
    int condition = yycnormal;
    switch (cond) {
        case Condition::normal: { break; }
    }
    for (;;) {
        state_.start();
    /*!re2c
        <normal> NUMBER     { return TokenType::num; }
        <normal> IDENTIFIER { return TokenType::id; }
        <normal> "_"        { return TokenType::anon; }
        <normal> VARIABLE   { return TokenType::var; }
        <normal> STRING     { return TokenType::str; }
        <normal> "("        { return TokenType::lpar; }
        <normal> ")"        { return TokenType::rpar; }
        <normal> "+"        { return TokenType::plus; }
        <normal> "-"        { return TokenType::minus; }
        <normal> "*"        { return TokenType::star; }
        <normal> "**"       { return TokenType::dstar; }
        <normal> "/"        { return TokenType::slash; }
        <normal> "\\"       { return TokenType::bslash; }
        <normal> "?"        { return TokenType::qmark; }
        <normal> "^"        { return TokenType::caret; }
        <normal> "&"        { return TokenType::amp; }
        <normal> "|"        { return TokenType::bar; }
        <normal> ","        { return TokenType::comma; }
        <normal> ";"        { return TokenType::sem; }
        <normal> ":"        { return TokenType::colon; }
        <normal> "~"        { return TokenType::tilde; }
        <normal> "."        { return TokenType::dot; }
        <normal> ".."       { return TokenType::ddot; }
        <normal> "@"        { return TokenType::at; }
        <normal> SKIP       { continue; }
        <normal> NL         { state_.step(); continue; }
        <normal> KEYWORD    { return TokenType::error; }
        <*> *               { return TokenType::error; }
        <*> $               { return TokenType::end; }
    */
    }
}
