auto construct_{{ type.name }}(clingo_ast_t **ast, size_t size) -> {{ type_name }} {
    {{ type_name }} ret;
    try {
        ret.reserve(size);
        std::for_each_n(ast, size, [&ret](auto &arg){
            auto tmp = arg;
            arg = nullptr;
            ret.emplace_back({{ cons }}(tmp));
        });
        clingo_ast_array_free(ast, size);
    }
    catch (...) {
        clingo_ast_array_free(ast, size);
        throw;
    }
    return ret;
}
{%    elif type.type == 'union' %}
auto construct_{{ type.name }}(clingo_ast_t *ast) -> {{ type_name }} {
    clingo_ast_type_t type;
    if (!clingo_ast_get_type(ast, &type)) {
        clingo_ast_free(ast);
        throw std::runtime_error("could not get type");
    }
    switch (type) {
{%-     for sub_type in type.types | flatten_types(type_map) %}
        case clingo_ast_type_{{sub_type}}: {
            return {{ sub_type | camel }}::acquire(ast);
        }
{%-     endfor %}
    }
    clingo_ast_free(ast);
    throw std::runtime_error("unexpected ast type");
}
{%    elif type.type == 'record' %}
{%- include "_record_define_cpp.j2" %}
{%    endif %}
{%- endfor %}
template <class... Ts>
auto c_cast(std::variant<Ts...> const &var) -> clingo_ast_t* {
    return std::visit([](auto const &x) { return c_cast(x); }, var);
}

template <class T>
auto c_cast(std::vector<T> const &arr) -> std::vector<clingo_ast_t*> {
    std::vector<clingo_ast_t*> ret;
    ret.reserve(arr.size());
    for (auto const &x : arr)  {
        ret.emplace_back(c_cast(x));
    }
    return ret;
}

auto parse_term(Library &lib, char const *string) -> Term {
    clingo_ast_t *ast;
    handle_error(lib, clingo_ast_parse_expression(lib, clingo_ast_parse_type_term, string, &ast));
    return construct_term(ast);
}

auto parse_literal(Library &lib, char const *string) -> Literal {
    clingo_ast_t *ast;
    handle_error(lib, clingo_ast_parse_expression(lib, clingo_ast_parse_type_literal, string, &ast));
    return construct_literal(ast);
}

void register_module(pybind11::module &m) {
    auto ast = m.def_submodule("ast", doc(R"(
This module provides functions to work with Abstract Syntax Trees of logic programs.
)"));

    ast.def("_type_info_yaml", &clingo_ast_type_info_yaml, doc(R"(
Return a yaml description of the AST.

This can be used to auto-generate most of the binding.)"));
{%  for type in types -%}
{%    set type_name = type.name | camel -%}
{%    if type.type == 'enum' %}
    py::enum_<{{ type_name }}>(ast, "{{ type_name }}", R"doc({{ type.doc }})doc")
{%-     for value_name, value_type in type["values"].items() %}
        .value("{{ value_name | camel }}", {{ type_name }}::{{ value_name | camel }}, R"doc({{ value_type.doc }})doc")
{%-       if loop.last %};{% endif -%}
{%-     endfor %}
{%    elif type.type == 'record' %}
    py::class_<{{ type_name }}>(ast, "{{ type_name }}", R"doc({{ type.doc | doc }})doc")
        .def(py::init(&{{ type_name }}::construct), py::arg("lib")
        {%- for argument in type.arguments -%}
            , py::arg("{{ argument.name }}")
            {%- if "default" in argument %}
              {%- if argument.type == "bool" %} = {{ argument.default | string | lower }}
              {%- elif type_map[argument.type].type == "array" and argument.default == "empty" %} = {{ argument.type | camel }}{}
              {%- endif %}
            {%- endif %}
        {%- endfor %}, R"doc(Construct a {{ type_name }} object.

Parameters
----------
lib
    The library object for storing symbols.
{%-     for argument in type.arguments %}
{{ argument.name }}
{{ argument.doc | param_doc }}
{%-     endfor %})doc")
        .def("__str__", &{{ type_name }}::to_string)
        .def("__hash__", &{{ type_name }}::hash)
{%-     for argument in type.arguments %}
        .def_property_readonly("{{argument.name}}", &{{ type_name }}::{{argument.name}})
{%-     endfor %}
        // generate comparison operators
        CLINGO_PY_TOTAL_ORDER;
{%    endif %}
{%- endfor %}
    ast.def("parse_term", &parse_term, py::arg("lib"), py::arg("string"), R"doc(Parse a term.

Parameters
----------
lib
    The library object for storing symbols.
string
    The string to parse.

Returns
-------
The parsed Term object.)doc");
    ast.def("parse_literal", &parse_literal, py::arg("lib"), py::arg("string"), R"doc(Parse a literal.

Parameters
----------
lib
    The library object for storing symbols.
string
    The string to parse.

Returns
-------
The parsed Literal object.)doc");
}

